#!/usr/bin/env bash
# Blocks commits containing secrets (API keys, tokens, etc).
# Uses gitleaks against staged changes only.

set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
pre-commit: gitleaks not found.
Install it:
  macOS:   brew install gitleaks
  Linux:   https://github.com/gitleaks/gitleaks/releases
To bypass (NOT recommended): git commit --no-verify
EOF
  exit 1
fi

TOP="$(git rev-parse --show-toplevel)"
fail() {
  cat >&2 <<'EOF'

pre-commit: secrets detected in staged changes (see output above).
- If false positive, add to .gitleaks.toml [[allowlists]].
- If real, REMOVE the secret, rotate the credential, and restage.
- To bypass (NOT recommended): git commit --no-verify
EOF
  exit 1
}

gitleaks git --pre-commit --staged --redact --verbose --no-banner --config "$TOP/.gitleaks.toml" "$TOP" || fail

# gitleaks' built-in config never opens lockfiles, *.svg, go.mod, vendored
# directories and a few more, so a token there passes the scan above. Staged
# copies of those files are scanned again under neutral names.
# The list mirrors secret-gate.sh in the repo-tidy skill.
SKIPPED='gitleaks\.toml|\.(bmp|gif|jpe?g|png|svg|tiff?|eot|[ot]tf|woff2?|docx?|xlsx?|pdf|bin|socket|vsidx|v2|suo|wsuo|dll|pdb|exe|gltf|gem)$|go\.(mod|sum|work(\.sum)?)$|(^|/)(node_modules|bower_components|vendor)/|(^|/)(deno\.lock|npm-shrinkwrap\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|pipfile\.lock|poetry\.lock|gradle\.lockfile|gradlew(\.bat)?|mvnw(\.cmd)?|javascript\.json)$|(^|/)\.mvn/wrapper/|(^|/)(angular|bootstrap|jquery(-?ui)?|plotly|swagger-?ui)[a-z0-9.-]*\.js(\.map)?$|verification-metadata\.xml|database\.refactorlog|(^|/)(v?env|virtualenv)/lib|(^|/)(lib(64)?/python[23]|python/[23])|\.dist-info(/|$)|\.min\.js(\.map)?$'
tmp=$(mktemp -d); trap 'rm -rf "$tmp" "$tmp.map"' EXIT
n=0
git -C "$TOP" diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' f; do
  [ "$f" = ".gitleaks.toml" ] && continue
  if printf '%s' "$f" | tr 'A-Z' 'a-z' | grep -qE "$SKIPPED"; then
    n=$((n + 1)); git -C "$TOP" show ":$f" > "$tmp/$n.txt" 2>/dev/null; printf '%s.txt  %s\n' "$n" "$f" >> "$tmp.map"
  fi
done
if [ -s "$tmp.map" ]; then
  gitleaks dir --redact --verbose --no-banner --max-archive-depth 3 --config "$TOP/.gitleaks.toml" "$tmp" || {
    echo "pre-commit: the numbered files above are these staged files:" >&2; cat "$tmp.map" >&2; fail
  }
fi
