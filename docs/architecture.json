  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "User picks a profile; the app builds a composite scan adapter",
        "Findings are classified safe, review, or protected from bundled rules",
        "Destructive actions need a LicenseGate authorization value",
        "CleanupEngine skips protected roots and moves items to Trash"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "App, scheduler, MCP and cleanup run unprivileged as the user",
        "Root helper accepts only XPC peers matching the app signing requirement",
        "MCP SSE listens on a configured bind host and checks a bearer token",
        "Release builds ignore GARGANTUA_RULES_DIR and use bundled rules"
      ]
    },
    {
      "dot": "violet",
      "title": "MCP and scheduler",
      "items": [
        "MCP clean runs the license gate, then a notification grace period",
        "MCP clean is rate limited and writes audit entries",
        "Scheduler runs scans only and never cleans"
      ]
    },
    {
      "dot": "amber",
      "title": "Other externals",
      "items": [
        "Anthropic Messages API for opt-in cloud AI explanations",
        "Hugging Face for the default local MLX model download",
        "Sparkle appcast for updates; feedback Worker for reports",
        "Vendored fclones and czkawka binaries for duplicates and file health"
      ]
    }
  ]
